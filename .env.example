# ============================================================
# Platform Parent - Ortam Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyala ve değerleri doldur:
#   cp .env.example .env
#
# .env dosyasını asla Git'e commit ETME! (.gitignore'da var)
# ============================================================

# ── Veritabanı ──────────────────────────────────────────────
POSTGRES_DB=platformdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=güçlü_şifre_girin

# ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=redis_şifre_girin

# ── JWT ─────────────────────────────────────────────────────
# En az 64 karakter, rastgele bir string olmalı
# Üretmek için: openssl rand -hex 64
JWT_SECRET=buraya_en_az_64_karakterlik_rastgele_bir_string_girin_asla_default_birakmayın

# ── Uygulama Profili ────────────────────────────────────────
# dev veya prod
SPRING_PROFILES_ACTIVE=dev

# ── Dosya Depolama ──────────────────────────────────────────
STORAGE_BASE_URL=http://localhost:8081/files
